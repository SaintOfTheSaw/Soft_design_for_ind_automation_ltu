<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="176990c5-56f0-4575-b452-1b422f0ededc" Name="Master" Comment="Basic Function Block Type" Namespace="Main">
  <Identification Standard="61499-2" />
  <VersionInfo Version="0.0" Author="midxav" Date="1/14/2024" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Comment="Initialization Request">
        <With Var="LuggageLifted" />
        <With Var="LuggageArrived" />
        <With Var="PusherRetractedCNF" />
        <With Var="LiftRetractedCNF" />
        <With Var="LiftExtendedCNF" />
        <With Var="PusherExtendedCNF" />
      </Event>
      <Event Name="REQ" Comment="Normal Execution Request">
        <With Var="LuggageLifted" />
        <With Var="LuggageArrived" />
        <With Var="PusherRetractedCNF" />
        <With Var="LiftRetractedCNF" />
        <With Var="LiftExtendedCNF" />
        <With Var="PusherExtendedCNF" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Comment="Initialization Confirm" />
      <Event Name="CNF" Comment="Execution Confirmation" />
      <Event Name="PEXTEND" />
      <Event Name="LEXTEND" />
      <Event Name="LRETRACT" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="LuggageLifted" Type="BOOL" />
      <VarDeclaration Name="LuggageArrived" Type="BOOL" />
      <VarDeclaration Name="PusherRetractedCNF" Type="BOOL" />
      <VarDeclaration Name="PusherExtendedCNF" Type="BOOL" />
      <VarDeclaration Name="LiftExtendedCNF" Type="BOOL" />
      <VarDeclaration Name="LiftRetractedCNF" Type="BOOL" />
    </InputVars>
  </InterfaceList>
  <BasicFB>
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="" />
    <ECC>
      <ECState Name="START" Comment="Initial State" x="3680.942" y="129.4117" />
      <ECState Name="INIT" Comment="Initialization" x="3671.53" y="673.1764">
        <ECAction Output="INITO" />
      </ECState>
      <ECState Name="INITIAL" x="3684" y="1356">
        <ECAction Output="CNF" />
      </ECState>
      <ECState Name="LIFT_LUGGAGE" x="2964" y="2220">
        <ECAction Output="LEXTEND" />
      </ECState>
      <ECState Name="PUSH_LUGGAGE" x="604.9999" y="2106">
        <ECAction Output="PEXTEND" />
      </ECState>
      <ECState Name="LUGGAGE_PUSHED" x="1036" y="1093">
        <ECAction Output="LRETRACT" />
      </ECState>
      <ECTransition Source="START" Destination="INIT" Condition="INIT" x="3687.944" y="388.9441">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="922.9851,77.89481,922.3171,114.5189" />
      </ECTransition>
