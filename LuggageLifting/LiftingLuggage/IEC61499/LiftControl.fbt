<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="301cda55-48c2-49ea-953b-90e642ec8fe3" Name="LiftControl" Comment="Basic Function Block Type" Namespace="Main">
  <Identification Standard="61499-2" />
  <VersionInfo Version="0.0" Author="midxav" Date="1/14/2024" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Comment="Initialization Request">
        <With Var="LiftRetracted" />
        <With Var="LiftExtended" />
      </Event>
      <Event Name="REQ" Comment="Normal Execution Request">
        <With Var="LiftRetracted" />
        <With Var="LiftExtended" />
      </Event>
      <Event Name="RETRACT">
        <With Var="LiftRetracted" />
        <With Var="LiftExtended" />
      </Event>
      <Event Name="EXTEND">
        <With Var="LiftRetracted" />
        <With Var="LiftExtended" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Comment="Initialization Confirm">
        <With Var="ExtendLift" />
        <With Var="RetractLift" />
      </Event>
      <Event Name="CNF" Comment="Execution Confirmation">
        <With Var="ExtendLift" />
        <With Var="RetractLift" />
        <With Var="LExtended" />
        <With Var="LRetracted" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="LiftRetracted" Type="BOOL" Comment="Input event qualifier" />
      <VarDeclaration Name="LiftExtended" Type="BOOL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="ExtendLift" Type="BOOL" Comment="Output event qualifier" />
      <VarDeclaration Name="RetractLift" Type="BOOL" />
      <VarDeclaration Name="LExtended" Type="BOOL" />
      <VarDeclaration Name="LRetracted" Type="BOOL" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="INIT,INITIAL,EXTENDING,EXTENDED,RETRACTING" />
    <ECC>
      <ECState Name="START" Comment="Initial State" x="3660.942" y="129.4117" />
