    <Algorithm Name="INIT">
      <ST><![CDATA[ExtendLift:= FALSE;
RetractLift:=TRUE;
LExtended:=FALSE;
LRetracted:= FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="INITIAL">
      <ST><![CDATA[RetractLift:=FALSE;
LRetracted := TRUE;
]]></ST>
    </Algorithm>
    <Algorithm Name="EXTENDING">
      <ST><![CDATA[ExtendLift:=TRUE;
LRetracted:=FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="EXTENDED">
      <ST><![CDATA[ExtendLift:=FALSE;
LExtended :=TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="RETRACTING">
      <ST><![CDATA[RetractLift:=TRUE;
LExtended := FALSE;]]></ST>
