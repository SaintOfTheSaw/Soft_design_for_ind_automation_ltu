        <ECAction Algorithm="INIT" Output="INITO" />
      </ECState>
      <ECState Name="INITIAL" x="3684" y="1356">
        <ECAction Algorithm="INITIAL" Output="CNF" />
      </ECState>
      <ECState Name="EXTENDING" x="2964" y="2220">
        <ECAction Algorithm="EXTENDING" Output="CNF" />
      </ECState>
      <ECState Name="EXTENDED" x="470" y="1961">
        <ECAction Algorithm="EXTENDED" Output="CNF" />
      </ECState>
      <ECState Name="RETRACTING" x="1781" y="1393">
        <ECAction Algorithm="RETRACTING" Output="CNF" />
      </ECState>
