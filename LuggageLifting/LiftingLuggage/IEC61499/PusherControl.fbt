<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="a4d67291-072b-4087-8381-fa86388d42ac" Name="PusherControl" Comment="Basic Function Block Type" Namespace="Main">
  <Identification Standard="61499-2" />
  <VersionInfo Version="0.0" Author="midxav" Date="1/14/2024" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Comment="Initialization Request">
        <With Var="PusherRetracted" />
        <With Var="PusherExtended" />
      </Event>
      <Event Name="REQ" Comment="Normal Execution Request">
        <With Var="PusherRetracted" />
        <With Var="PusherExtended" />
      </Event>
      <Event Name="EXTEND">
        <With Var="PusherRetracted" />
        <With Var="PusherExtended" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Comment="Initialization Confirm">
        <With Var="ExtendPusher" />
      </Event>
      <Event Name="CNF" Comment="Execution Confirmation">
        <With Var="ExtendPusher" />
        <With Var="PRetracked" />
        <With Var="PExtended" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="PusherRetracted" Type="BOOL" />
      <VarDeclaration Name="PusherExtended" Type="BOOL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="ExtendPusher" Type="BOOL" />
      <VarDeclaration Name="PRetracked" Type="BOOL" />
      <VarDeclaration Name="PExtended" Type="BOOL" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="INIT,EXTENDING,EXTENDED,RETRACTED,RETRACTING" />
    <ECC>
      <ECState Name="START" Comment="Initial State" x="3680.942" y="129.4117" />
      <ECState Name="INIT" Comment="Initialization" x="3671.53" y="673.1764">
        <ECAction Algorithm="INIT" Output="INITO" />
      </ECState>
      <ECState Name="INITIAL" x="3680" y="1284">
        <ECAction Algorithm="RETRACTED" Output="CNF" />
      </ECState>
      <ECState Name="EXTENDING" x="2612" y="2160">
        <ECAction Algorithm="EXTENDING" Output="CNF" />
      </ECState>
      <ECState Name="EXTENDED" x="916" y="1368">
        <ECAction Algorithm="EXTENDED" Output="CNF" />
      </ECState>
      <ECState Name="RETRACTING" x="2170" y="895">
        <ECAction Algorithm="RETRACTING" Output="CNF" />
      </ECState>
      <ECTransition Source="START" Destination="INIT" Condition="INIT" x="3687.944" y="388.9441">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="922.9851,77.89481,922.3171,114.5189" />
      </ECTransition>
      <ECTransition Source="INIT" Destination="INITIAL" Condition="REQ AND PusherRetracted" x="3683.728" y="998.9146">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="921.0218,230.246,921.7883,272.599" />
      </ECTransition>
      <ECTransition Source="EXTENDING" Destination="EXTENDED" Condition="REQ AND PusherExtended" x="1556.97" y="2016.209">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="447.3902,551.4407,310.7079,493.4343" />
      </ECTransition>
      <ECTransition Source="INITIAL" Destination="EXTENDING" Condition="EXTEND" x="3200.656" y="1779.989">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="841.553,417.6781,763.1563,481.9811" />
      </ECTransition>
      <ECTransition Source="EXTENDED" Destination="RETRACTING" Condition="1" x="1550.853" y="1049.498">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="351.5721,272.2448,435.4663,240.3952" />
      </ECTransition>
      <ECTransition Source="RETRACTING" Destination="INITIAL" Condition="REQ AND PusherRetracted" x="2989.075" y="1016.183">
        <Attribute Name="Configuration.Transaction.BezierPoints" Value="698.5829,236.4126,797.7533,262.3523" />
      </ECTransition>
