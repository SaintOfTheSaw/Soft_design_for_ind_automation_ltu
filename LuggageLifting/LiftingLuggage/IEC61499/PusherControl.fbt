    <Algorithm Name="INIT" Comment="Initialization algorithm">
      <ST><![CDATA[ExtendPusher:= FALSE;
PRetracked:= FALSE;
PExtended := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="EXTENDING">
      <ST><![CDATA[ExtendPusher:=TRUE;
PRetracked:=FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="EXTENDED">
      <ST><![CDATA[ExtendPusher:=FALSE;
PExtended:=TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="RETRACTED">
      <ST><![CDATA[;
PRetracked:= TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="RETRACTING">
      <ST><![CDATA[PExtended:= FALSE;]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>