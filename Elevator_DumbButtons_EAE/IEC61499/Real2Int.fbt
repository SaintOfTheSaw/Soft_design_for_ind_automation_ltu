<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="cae53535-31a9-49bb-90af-cf661716598b" Name="Real2Int" Comment="Basic Function Block Type" Namespace="Main">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.0" Author="Cheyan" Date="7/13/2023" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ" Comment="Normal Execution Request">
        <With Var="Input" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Comment="Execution Confirmation">
        <With Var="Output" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="Input" Type="REAL" Comment="Input event qualifier" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="Output" Type="INT" Comment="Output event qualifier" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="REQ" />
    <ECC>
      <ECState Name="START" Comment="Initial State" x="552.9412" y="429.4117" />
      <ECState Name="REQ" Comment="Normal execution" x="217.647" y="752.9412">
        <ECAction Algorithm="REQ" Output="CNF" />
      </ECState>
      <ECTransition Source="START" Destination="REQ" Condition="REQ" x="447.8488" y="648.3352" />
      <ECTransition Source="REQ" Destination="START" Condition="1" x="372.8767" y="512.7991" />
    </ECC>
    <Algorithm Name="REQ" Comment="Normally executed algorithm">
      <ST Text=";&#xD;&#xA;&#xD;&#xA;IF Input = 0.0 THEN&#xD;&#xA;	Output:=0;&#xD;&#xA;ELSIF Input = 1.0 THEN&#xD;&#xA;	Output:=1;&#xD;&#xA;ELSIF Input = 2.0 THEN&#xD;&#xA;	Output:=2;&#xD;&#xA;ELSIF Input = 3.0 THEN&#xD;&#xA;	Output:=3;&#xD;&#xA;ELSIF Input = 4.0 THEN&#xD;&#xA;	Output:=4;&#xD;&#xA;ELSIF Input = 5.0 THEN&#xD;&#xA;	Output:=5;&#xD;&#xA;END_IF;&#xD;&#xA;" />
    </Algorithm>
  </BasicFB>
</FBType>