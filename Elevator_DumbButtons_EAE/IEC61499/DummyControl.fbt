    <Algorithm Name="REQ" Comment="Normally executed algorithm">
      <ST Text="IF AtFloor0 THEN&#xD;&#xA;	liftUp := TRUE;&#xD;&#xA;	liftDown := FALSE;&#xD;&#xA;END_IF;&#xD;&#xA;IF AtFloor2 THEN&#xD;&#xA;	liftDown := TRUE;&#xD;&#xA;	liftUp := FALSE;&#xD;&#xA;END_IF;&#xD;&#xA;&#xD;&#xA;/*IF Button0 OR Req0 THEN&#xD;&#xA;	door0 := TRUE;&#xD;&#xA;ELSE&#xD;&#xA;	door0 := FALSE;&#xD;&#xA;END_IF;&#xD;&#xA;IF Button1 OR Req1 THEN&#xD;&#xA;	door1 := TRUE;&#xD;&#xA;ELSE&#xD;&#xA;	door1 := FALSE;&#xD;&#xA;END_IF;&#xD;&#xA;IF Button2 OR Req2 THEN&#xD;&#xA;	door2 := TRUE;&#xD;&#xA;ELSE&#xD;&#xA;	door2 := FALSE;&#xD;&#xA;END_IF;*/&#xD;&#xA;door0 := Button0 OR Req0;&#xD;&#xA;door1 := Button1 OR Req1;&#xD;&#xA;door2 := Button2 OR Req2;&#xD;&#xA;&#xD;&#xA;LightON_Button0 := Button0;&#xD;&#xA;LightON_Button1 := Button1;&#xD;&#xA;LightON_Button2 := Button2;&#xD;&#xA;&#xD;&#xA;LightON_Panel0 := Req0;&#xD;&#xA;LightON_Panel1 := Req1;&#xD;&#xA;LightON_Panel2 := Req2;&#xD;&#xA;&#xD;&#xA;" />
    </Algorithm>
